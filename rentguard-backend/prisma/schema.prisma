datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TENANT
  LANDLORD
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relational Connections
  leasesAsLandlord Lease[]    @relation("LandlordLeases")
  leasesAsTenant   Lease[]    @relation("TenantLeases")
  submittedLogs    AuditLog[]
}

model Lease {
  id             String   @id @default(uuid())
  propertyName   String   // e.g., "Apt 4B - Horizon Apartments"
  inviteCode     String   @unique // Generated by landlord, used by tenant to join
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Relations
  landlordId     String
  landlord       User     @relation("LandlordLeases", fields: [landlordId], references: [id])
  
  tenantId       String?
  tenant         User?    @relation("TenantLeases", fields: [tenantId], references: [id])

  auditLogs      AuditLog[]
}

model AuditLog {
  id             String   @id @default(uuid())
  area           String   // e.g., "Kitchen Sink", "Master Bedroom Wall"
  conditionNotes String
  imageUrl       String?  // Cloudinary image URL
  timestamp      DateTime @default(now())

  // Security & Cryptographic Ledger
  currentHash    String   // SHA-256 (leaseId + area + notes + imgUrl + prevHash)
  previousHash   String   // Hash pointer to previous log entry

  // Relations
  leaseId        String
  lease          Lease    @relation(fields: [leaseId], references: [id])

  submittedById  String
  submittedBy    User     @relation(fields: [submittedById], references: [id])
}